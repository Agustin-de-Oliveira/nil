{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "nil-shot",
  "version": "0.5.0",
  "identifier": "com.nil.shot",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../frontend/nil-shot/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Capturador y editor de pantalla rápido para Linux",
    "longDescription": "nil-shot es una herramienta moderna de captura, anotación, desenfoque y OCR para Linux.",
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": ["libgtk-3-0", "libnotify-bin", "tesseract-ocr"]
      },
      "rpm": {
        "depends": ["gtk3", "libnotify", "tesseract"]
      }
    }
  }
}
